{
  "name": "@ocp-catalog/ocp-client",
  "version": "0.2.1",
  "description": "Typed client helpers and validators for the Open Commerce Protocol (OCP) Catalog.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Commerce-Protocol/OCP-Catalog.git",
    "directory": "packages/ocp-client"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/index.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun ../../scripts/build-protocol-package.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@ocp-catalog/ocp-activity-schema": "^0.2.1",
    "@ocp-catalog/ocp-schema": "^0.2.1",
    "@ocp-catalog/registration-schema": "^0.2.1"
  }
}
